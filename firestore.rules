rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "giftformenow@gmail.com";
    }
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── CONFIG / PARAMÈTRES ──
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
      // Utilisateurs auth peuvent SEULEMENT incrémenter totalUsers
      allow update: if isAuth() && !isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalUsers']);
    }

    // ── UTILISATEURS ──
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.get('blocked', false) == false;
      allow update: if isAdmin()
        || (isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blocked','vip']));
      allow delete: if isAdmin();
    }

    // ── TRANSFERTS ──
    match /transferts/{txId} {
      allow read:   if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.statut == 'a_valider';
      allow update: if isAdmin()
        // Annulation : a_valider ou en_attente → annulee
        || (isAuth()
            && resource.data.userId == request.auth.uid
            && (resource.data.statut == 'a_valider' || resource.data.statut == 'en_attente')
            && request.resource.data.statut == 'annulee')
        // Envoi preuve : en_attente ou manque_info → preuve_envoyee
        || (isAuth()
            && resource.data.userId == request.auth.uid
            && (resource.data.statut == 'en_attente' || resource.data.statut == 'manque_info')
            && request.resource.data.statut == 'preuve_envoyee'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['statut','preuveUserUrl','preuveUpdatedAt','preuveHistorique']))
        // Marquer avis soumis sur transfert terminé
        || (isAuth()
            && resource.data.userId == request.auth.uid
            && resource.data.statut == 'terminee'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avisSubmitted']));
      allow delete: if isAdmin();
    }

    // ── CONVERSATIONS ──
    // Ancien systeme de chat (remplace par les tickets) : plus utilise par le site.
    match /conversations/{convId} {
      allow read, write: if isAdmin();
    }

    // ── MESSAGES ──
    // Ancien systeme de chat (remplace par les tickets) : plus utilise par le site.
    match /messages/{msgId} {
      allow read, write: if isAdmin();
    }

    // ── CONTACTS (formulaire public) ──
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['nom','email','message','timestamp','lu'])
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }

    // ── VISITES ──
    match /visits/{visitId} {
      allow create, update: if true;
      allow read, delete:   if isAdmin();
    }

    // ── TICKETS SUPPORT ──
    match /tickets/{ticketId} {
      allow read:   if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.statut == 'ouvert'
        && request.resource.data.keys().hasOnly(['userId','nom','email','objet','statut','createdAt','updatedAt','lastMessage','unreadAdmin','unreadUser'])
        && request.resource.data.objet is string && request.resource.data.objet.size() <= 100;
      allow update: if isAdmin()
        || (isAuth()
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['statut','updatedAt','unreadAdmin','unreadUser','lastMessage','lastMessageAt'])
            // Réponse (statut inchangé) OU clôture du ticket
            && (request.resource.data.statut == resource.data.statut
                || request.resource.data.statut == 'cloture'));
      allow delete: if isAdmin();

      // Messages du ticket
      match /messages/{msgId} {
        allow read:  if isAdmin()
          || (isAuth() && get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid);
        // Admin : tout. Client : uniquement sur SON ticket ouvert, en tant que 'user', texte seul.
        allow create: if isAuth()
          && get(/databases/$(database)/documents/tickets/$(ticketId)).data.statut != 'cloture'
          && (isAdmin()
              || (get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid
                  && request.resource.data.from == 'user'
                  && request.resource.data.keys().hasOnly(['from','text','fileUrl','fileType','fileName','timestamp','readByAdmin','readByUser'])
                  && request.resource.data.text is string
                  && request.resource.data.text.size() <= 1000
                  && request.resource.data.fileUrl == null));
        // Admin : tout. Client : seulement marquer un message admin comme lu.
        allow update: if isAdmin()
          || (isAuth()
              && get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid
              && resource.data.from == 'admin'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByUser']));
        allow delete: if isAdmin();
      }
    }

    // ── AVIS CLIENTS ──
    match /avis/{avisId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ── LOGS D'ERREURS JS (monitoring basique) ──
    match /errorLogs/{logId} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() < 500
        && request.resource.data.keys().hasOnly(['message','stack','url','page','userAgent','userId','createdAt']);
      allow update: if false;
    }

  }
}
